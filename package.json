{
  "name": "nyota",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n hub,mcp,editor -c yellow,blue,magenta \"npm run hub\" \"npm run dev -w @nyota/server\" \"npm run dev -w @nyota/editor\"",
    "fidelity": "node tests/fidelity/run.mjs",
    "typecheck": "tsc -p packages/core && tsc -p apps/server && tsc -p apps/editor",
    "test": "tsx --test packages/core/test/*.test.ts",
    "hub": "cross-env NYOTA_MCP_URL=http://localhost:4001 NYOTA_LEGACY_DOC=apps/server/data/document.json cargo run --manifest-path apps/hub/Cargo.toml",
    "test:hub": "cargo test --manifest-path apps/hub/Cargo.toml"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3"
  }
}
