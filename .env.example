# Copier en .env puis : docker compose --profile https up -d
# Domaine public (enregistrement DNS A/AAAA vers ce serveur ; ports 80 et 443 ouverts)
SWIFTMA_DOMAIN=design.example.org
SWIFTMA_PUBLIC_URL=https://design.example.org
# Obligatoire derrière HTTPS
SWIFTMA_SECURE_COOKIES=1
# open : inscriptions libres ; closed : l'administrateur crée les comptes
SWIFTMA_SIGNUP=closed
# Facultatif : agent IA intégré
ANTHROPIC_API_KEY=
